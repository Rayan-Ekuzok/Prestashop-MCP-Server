# Static analysis against a real PrestaShop.
#
# Needs the dev tools (composer install --working-dir=dev/tools) and the path
# of a PrestaShop folder in _PS_ROOT_DIR_ - an installed shop, or the files of
# the prestashop/prestashop docker image, which is what CI uses:
#
#   _PS_ROOT_DIR_=/path/to/prestashop dev/tools/vendor/bin/phpstan analyse -c phpstan.dist.neon
includes:
    - dev/tools/vendor/prestashop/php-dev-tools/phpstan/ps-module-extension.neon

parameters:
    level: 5
    paths:
        - somcp.php
        - classes
        - controllers
        - src
        - tools
    excludePaths:
        - vendor
        - dev
        - docs
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # StockAvailable::dependsOnStock() exists on 8.x and was removed on 9.x;
        # the call site guards with method_exists().
        -
            identifier: staticMethod.notFound
            path: tools/SomcpToolSetOrderStatus.php
